{
  "name": "nodal-ai",
  "version": "1.0.0",
  "description": "Modular, secure Stellar Agent Kit with PayFi / x402 support",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/cjs/sdk.js",
  "module": "./dist/esm/sdk.js",
  "types": "./dist/types/sdk.d.ts",
  "exports": {
    ".": {
      "import": "./dist/esm/sdk.js",
      "require": "./dist/cjs/sdk.js",
      "types": "./dist/types/sdk.d.ts"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "npx ts-node backend/mcp/index.ts",
    "mcp:start": "node dist/backend/mcp/index.js",
    "setup": "npx ts-node scripts/setup.ts",
    "doctor": "npx ts-node scripts/doctor.ts",
    "audit:verify": "npx ts-node scripts/audit_verify.ts",
    "db:prune": "npx ts-node scripts/db_prune.ts",
    "build": "tsc && node -e \"require('fs').cpSync('backend/db/migrations', 'dist/backend/db/migrations', { recursive: true })\"",
    "build:lib": "tsc --project tsconfig.lib.json",
    "build:lib:esm": "tsc --project tsconfig.lib.esm.json",
    "build:pkg": "npm run build:lib && npm run build:lib:esm",
    "pretest": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test:fuzz": "vitest run tests/fuzz/**",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:ts:coverage": "vitest run --coverage",
    "test:rust": "cargo test --locked --manifest-path contracts/escrow/Cargo.toml",
    "test:rust:coverage": "cargo tarpaulin --locked --manifest-path contracts/escrow/Cargo.toml --out Html --output-dir coverage/rust",
    "check:wasm-size": "bash scripts/check_wasm_size.sh",
    "bindings:escrow": "bash scripts/generate_escrow_bindings.sh",
    "build:policy-wasm": "bash scripts/build_policy_wasm.sh",
    "deploy:policy": "ts-node scripts/deploy_policy.ts",
    "test:e2e": "vitest run tests/e2e/**",
    "test:e2e:escrow": "vitest run tests/e2e/escrow_flow.test.ts",
    "test:all": "npm run test:rust && npm run test:ts",
    "load-test": "ts-node --esm tests/load/run_load_tests.ts",
    "lint": "eslint backend/**/*.ts tests/**/*.ts",
    "test:mutation": "stryker run stryker.config.mjs",
    "test:ai-safety": "vitest run tests/ai-safety/**",
    "lint": "eslint \"backend/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"backend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"backend/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky install",
    "changelog:update": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "docs:generate": "typedoc",
    "docs:build": "npm run docs:generate && npx vitepress build docs",
    "docs:dev": "npx vitepress dev docs",
    "docs:preview": "npx vitepress preview docs",
    "eval:offline": "npx tsx tests/evals/runner.ts",
    "tools:schema": "npx ts-node backend/ai/toolSchemas.ts",
    "tools:schema:check": "npx ts-node backend/ai/toolSchemas.ts --check"
  },
  "lint-staged": {
    "backend/**/*.ts": [
      "eslint --fix"
    ],
    "tests/**/*.ts": [
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1121.0",
    "@opentelemetry/auto-instrumentations-node": "0.79.0",
    "@opentelemetry/sdk-node": "0.221.0",
    "@stellar/stellar-sdk": "16.4.1",
    "@x402/core": "2.30.0",
    "@x402/express": "2.30.0",
    "@x402/fetch": "2.30.0",
    "@x402/stellar": "2.30.0",
    "axios": "1.20.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "16.6.1",
    "express": "5.3.0",
    "opossum": "8.5.0",
    "pg": "8.23.1",
    "picomatch": "4.0.7",
    "pino": "10.3.1",
    "prom-client": "15.1.3",
    "smol-toml": "1.9.1",
    "yaml": "2.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/autocannon": "7.12.5",
    "@stryker-mutator/core": "9.6.1",
    "@stryker-mutator/vitest-runner": "9.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/opossum": "8.1.9",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "autocannon": "7.15.0",
    "conventional-changelog-cli": "5.0.0",
    "eslint": "8.57.1",
    "fast-check": "3.23.2",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vitest": "4.1.12"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.5"
    }
  }
}
