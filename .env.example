# Nodal AI environment configuration example
# Copy this file to .env and update values before running the application.
# See README.md for setup instructions.

# STELLAR_NETWORK: Stellar network to connect to.
# Required. Valid values: testnet, mainnet, futurenet.
STELLAR_NETWORK=testnet

# HORIZON_URL: Horizon API endpoint.
# Required. Example for testnet: https://horizon-testnet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# SOROBAN_RPC_URL: Soroban RPC endpoint.
# Required. Example for testnet: https://soroban-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# AGENT_SECRET_KEY: Stellar secret key used by the agent to sign transactions.
# Required. Must start with S and be 56 characters long.
AGENT_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# AGENT_PUBLIC_KEY: Corresponding Stellar public key.
# Optional. If provided, must start with G and be 56 characters long.
AGENT_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# X402_ASSET_CODE: Asset code used for x402 payments.
# Optional. Must be 1 to 12 characters.
X402_ASSET_CODE=USDC

# X402_ASSET_ISSUER: Issuer account for the x402 asset.
# Required for non-native assets like USDC. Must be a 56-character G-address.
X402_ASSET_ISSUER=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# AGENT_SPENDING_LIMIT: Maximum amount this agent may spend per task.
# Required. Positive decimal with up to 7 decimal places (e.g. 100 or 10.5000000).
AGENT_SPENDING_LIMIT=100

# MAX_RETRIES: Number of retry attempts for transient RPC failures.
# Optional. Integer between 1 and 10.
MAX_RETRIES=3

# RETRY_DELAY_MS: Initial retry delay in milliseconds for RPC retries.
# Optional. Integer >= 100.
RETRY_DELAY_MS=1500
