# =============================================================================
# Nodal AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Never commit .env to version control — it contains secrets.
# See backend/config.ts for full schema validation and defaults.
# =============================================================================

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# Stellar network to target.
# Valid values: testnet | mainnet | futurenet
# Default: testnet
STELLAR_NETWORK=testnet

# -----------------------------------------------------------------------------
# RPC Endpoints
# -----------------------------------------------------------------------------

# Horizon REST API URL for the selected network.
# Testnet:  https://horizon-testnet.stellar.org
# Mainnet:  https://horizon.stellar.org
# Futurenet: https://horizon-futurenet.stellar.org
HORIZON_URL=https://horizon-testnet.stellar.org

# Soroban RPC URL for the selected network.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/<API_KEY>
# Futurenet: https://rpc-futurenet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# -----------------------------------------------------------------------------
# Agent Identity
# -----------------------------------------------------------------------------

# Stellar secret key used to sign transactions (must start with S, 56 characters).
# Generate one at: https://laboratory.stellar.org/#account-creator
AGENT_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Stellar public key (G-address, 56 characters).
# Optional — derived automatically from AGENT_SECRET_KEY when omitted.
# Provide it as a cross-check; the agent will exit if it does not match the derived key.
# AGENT_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# AWS Secrets Manager ARN holding the agent secret key.
# Optional alternative to putting AGENT_SECRET_KEY in this file: when set, the
# key is fetched at startup and never written to disk. Requires AWS credentials
# with secretsmanager:GetSecretValue on the named secret.
# AGENT_SECRET_KEY_ARN=arn:aws:secretsmanager:us-east-1:123456789012:secret:nodal/agent-key-AbCdEf

# Signing backend used by createSigner() in backend/signers.
# Valid values: local | vault
#   local — sign with the in-memory agent keypair (AGENT_SECRET_KEY / ARN)
#   vault — sign with a HashiCorp Vault transit ed25519 key; the key never
#           leaves Vault. See "Remote Signer Backends" in README.md.
# Default: local
# SIGNER_BACKEND=local

# Vault settings — required when SIGNER_BACKEND=vault.
# VAULT_TOKEN is validated and held privately by backend/config.ts.
# VAULT_ADDR=https://vault.example.com:8200
# VAULT_TRANSIT_KEY=nodal-agent
# VAULT_TRANSIT_MOUNT=transit
# VAULT_TOKEN=hvs.xxxxx

# -----------------------------------------------------------------------------
# x402 / PayFi Asset
# -----------------------------------------------------------------------------

# Asset code for the x402 payment standard.
# Use "XLM" for native lumens, or a custom 1–12 character code (e.g. "USDC").
# Default: USDC
X402_ASSET_CODE=USDC

# Issuer account for the x402 asset (56-character G-address).
# Required for non-native assets. Ignored when X402_ASSET_CODE is "XLM".
X402_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Two different addresses identify the x402 asset — do not mix them up:
#   - X402_ASSET_ISSUER   (G…) the classic issuing account. Trustlines and classic
#                         payments use it.
#   - X402_ASSET_CONTRACT (C…) the asset's Stellar Asset Contract (SEP-41). Soroban
#                         transfers and x402 payment requirements use it.
# Optional: when unset it is derived from X402_ASSET_CODE + X402_ASSET_ISSUER and the
# network passphrase (Asset.contractId). If set, it must equal that derived address,
# so a value copied from another network or asset is rejected at startup.
# X402_ASSET_CONTRACT=C...

# Optional: maximum amount a single x402 challenge may request. Higher prices are rejected.
# X402_MAX_PRICE=5

# Optional: comma-separated origins allowed to receive x402 headers (CORS).
# Unset = all origins allowed.
# ALLOWED_X402_ORIGINS=https://example.com,https://app.example.com

# How long a used x402 nonce is retained before becoming eligible for eviction,
# in milliseconds. Must be an integer of at least 1.
# Default: 86400000 (24 hours)
# X402_NONCE_TTL_MS=86400000

# Optional: comma-separated assets x402 challenges may request — "XLM" or "CODE:ISSUER".
# When unset any asset is accepted, but a challenge for X402_ASSET_CODE must use X402_ASSET_ISSUER.
# X402_ALLOWED_ASSETS=XLM,USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Optional: comma-separated tokens the backend will accept as an escrow `token`
# argument — "XLM" or "CODE:ISSUER". When unset, only native XLM and the
# default x402 asset (X402_ASSET_CODE/ISSUER) are accepted.
# ESCROW_ALLOWED_TOKENS=XLM,USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# x402 v2 protocol options
# Set X402_USE_LEGACY=1 to stay on the legacy SHA-256-memo flow for one release.
# Default: 0 (v2 protocol active)
# X402_USE_LEGACY=0

# x402 facilitator for seller (nodalPaywall middleware) and buyer (fetchPaid).
# Coinbase testnet: https://x402.org/facilitator
# OpenZeppelin:     https://facilitator.openzeppelin.com
# X402_FACILITATOR_URL=https://x402.org/facilitator

# Optional API key for the facilitator (Bearer token).
# X402_FACILITATOR_API_KEY=your-api-key-here
# Optional OpenZeppelin facilitator API key, available through getOZApiKey().
# OZ_API_KEY=your-api-key-here

# -----------------------------------------------------------------------------
# Spending Cap
# -----------------------------------------------------------------------------

# Global maximum amount (in X402_ASSET_CODE units) the agent may spend cumulatively
# within the rolling SPENDING_WINDOW_MS window.
# Must be a positive decimal with up to 7 decimal places (e.g. "100" or "50.0000000").
# On mainnet the hard per-payment ceiling is 10,000 regardless of this value.
# Default: 100
AGENT_SPENDING_LIMIT=100

# Rolling time window for cumulative spending rate and cap computation, in milliseconds.
# Must be an integer of at least 100.
# Default: 86400000 (24 hours)
# SPENDING_WINDOW_MS=86400000

# Optional: per-asset spending limits within the rolling SPENDING_WINDOW_MS window.
# Format: comma-separated list of ASSET:LIMIT pairs, where ASSET is "XLM" or "CODE:ISSUER"
# and LIMIT is a positive decimal with up to 7 decimal places.
# Example: XLM:1000,USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5:500
# Note: SPENDING_LIMITS_MAP is derived internally from this key.
# SPENDING_LIMITS=XLM:1000,USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5:500

# When SPENDING_LIMITS is set, whether unlisted assets are permitted.
# When false (default), tasks moving unlisted assets fail with errorType POLICY_VIOLATION.
# When true, unlisted assets are capped individually by AGENT_SPENDING_LIMIT.
# Default: false
# SPENDING_LIMITS_ALLOW_UNKNOWN=false

# Optional: value-moving tasks above this amount are held as pending_approval
# instead of executing. List them with GET /approvals and decide with
# POST /approvals/:id {"decision":"approve"|"deny"} (Bearer ADMIN_API_TOKEN or
# an APPROVER_TOKENS credential). Unset = no approval step.
# APPROVAL_THRESHOLD=500

# Optional, overrides APPROVAL_THRESHOLD per asset (#953): comma-separated
# 'CODE:THRESHOLD' (XLM/native) or 'CODE:ISSUER:THRESHOLD' (credit assets).
# An asset not listed falls back to APPROVAL_THRESHOLD.
# APPROVAL_THRESHOLDS=XLM:5000,USDC:GA5Z...:500

# How long a pending approval waits for a decision before it expires and its
# spending reservation is released, in milliseconds. Must be at least 1000.
# Default: 3600000 (1 hour)
# APPROVAL_TTL_MS=3600000

# Named approver credentials (#954): 'name:sha256hex,...'. Each approver gets
# their own token, distinct from ADMIN_API_TOKEN, so the audit trail can say
# who decided and the admin token doesn't also have to be an approver token.
# Only the SHA-256 hex digest is stored here, never the raw token — compute
# it with e.g. `printf '%s' 'the-raw-token' | sha256sum`.
# APPROVER_TOKENS=alice:a845cf66e9773c6f2f5dc632637cb8d8ed55d0a2be24629c90292188b33af0fe,bob:878fe95a698bdfce4f3a91646e8295e02ee1490bf330ddf4241a2ce66e6ecbb8

# Optional (#954): above this amount, an approval needs APPROVAL_MIN_APPROVERS
# distinct approvers (from APPROVER_TOKENS) to agree before it executes.
# Unset = single-approver mode for every amount.
# APPROVAL_MULTI_APPROVER_THRESHOLD=5000

# Distinct approvers required above APPROVAL_MULTI_APPROVER_THRESHOLD.
# Default: 2
# APPROVAL_MIN_APPROVERS=2

# How value-moving MCP tool calls (MCP_ALLOW_PAYMENTS=true) are handled:
#   approve (default) - create a pending approval and return its id plus a
#                       deterministic summary; nothing moves until a human
#                       approves it via POST /approvals/:id
#   direct            - execute immediately (spending limits still apply);
#                       refused on mainnet unless MCP_FORCE_DIRECT_PAYMENTS=true
# MCP_PAYMENT_MODE=approve
# MCP_FORCE_DIRECT_PAYMENTS=false

# Counterparty policy for every value-moving task (incl. x402 payTo).
# Valid values: allowlist | denylist | open
#   allowlist — only the destinations listed below may be paid
#   denylist  — the destinations listed below may never be paid
#   open      — any destination may be paid
# Rejected tasks fail with errorType POLICY_VIOLATION.
# Default: open
# PAYMENT_DESTINATION_POLICY=allowlist

# Destinations the policy applies to: comma-separated G-addresses and/or
# federation names (name*domain), and/or a file with one entry per line
# (# starts a comment). Entries from both are combined.
# PAYMENT_DESTINATIONS=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5,merchant*example.com
# PAYMENT_DESTINATIONS_FILE=./payment_destinations.txt

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------

# Log verbosity level.
# Valid values: debug | info | warn | error
# Default: info
LOG_LEVEL=info

# Runtime environment name; controls whether logs are prettified.
# Default: development
# NODE_ENV=production

# OpenTelemetry Protocol (OTLP) gRPC/HTTP collector endpoint for telemetry export.
# Optional — OTLP telemetry export is disabled when unset.
# OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Whether transaction hashes are omitted from exported OpenTelemetry traces.
# Default: false
# OTEL_REDACT_TX_HASH=false

# -----------------------------------------------------------------------------
# Retry Behaviour
# -----------------------------------------------------------------------------

# Maximum number of retry attempts for transient network/RPC failures.
# Must be an integer between 1 and 10.
# Default: 3
MAX_RETRIES=3

# Base delay in milliseconds between retry attempts (exponential back-off).
# Must be an integer of at least 100.
# Actual delay = RETRY_DELAY_MS * 2^(attempt-1), capped at 30,000 ms, plus ±20% jitter.
# Default: 1500
RETRY_DELAY_MS=1500

# -----------------------------------------------------------------------------
# Concurrency & Rate Limiting
# -----------------------------------------------------------------------------

# Maximum number of tasks allowed to execute concurrently in agent.run().
# Tasks submitted while this many are already in flight are queued (bounded by
# QUEUE_CAPACITY) or rejected immediately if the queue is disabled/full.
# Must be an integer of at least 1.
# Default: 10
MAX_CONCURRENT_TASKS=10

# Bounded FIFO queue capacity for tasks submitted while at MAX_CONCURRENT_TASKS.
# 0 disables queuing — excess tasks are rejected immediately. Must be an
# integer of at least 0.
# Default: 0
QUEUE_CAPACITY=0

# Maximum number of x402 payments allowed per 60-second sliding window.
# Must be an integer of at least 1.
# Default: 10
MAX_X402_PAYMENTS_PER_MINUTE=10

# Maximum Soroban transaction fee in stroops (1 stroop = 0.0000001 XLM).
# Must be an integer of at least 100.
# Default: 1000000
MAX_SOROBAN_FEE_STROOPS=1000000

# Maximum per-operation inclusion fee in stroops bid by dynamic fee estimation
# (Horizon fee_stats), including the fee-bump retry on tx_insufficient_fee.
# Must be an integer of at least 100.
# Default: 100000
MAX_FEE_STROOPS=100000

# -----------------------------------------------------------------------------
# Anchor / SEP-0006 & SEP-0010
# -----------------------------------------------------------------------------

# Base URL of the Stellar anchor to authenticate with and deposit into.
# Used by scripts/examples/anchor_deposit.ts and StellarIdentityTool.
# Optional — ships with a working testnet default; override only if targeting
# a different anchor.
# Default: https://testanchor.stellar.org
# Mainnet USDC anchor (Circle/Centre): https://circle.anchor.stellar.org
ANCHOR_URL=https://testanchor.stellar.org

# Issuer account of the asset accepted by the anchor (56-character G-address).
# Optional — ships with a working testnet default; override only if targeting
# a different anchor.
# Default: GCDNJUBQSX7AJWLJACMJ7I4BC3Z47BQUTMHEICZLE6MU4KQBRYG5JY6
# (the Stellar Reference Token / SRT issuer used by the testnet demo anchor)
# Replace with the canonical USDC issuer on mainnet:
#   GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
ANCHOR_ASSET_ISSUER=GCDNJUBQSX7AJWLJACMJ7I4BC3Z47BQUTMHEICZLE6MU4KQBRYG5JY6

# Asset code the anchor accepts (default: SRT on testnet, USDC on mainnet).
# ANCHOR_ASSET_CODE=USDC

# Amount (in asset units) to deposit via the anchor example script.
# Must be a positive decimal with up to 7 decimal places.
# Default: 1.0000000
# ANCHOR_DEPOSIT_AMOUNT=1.0000000

# -----------------------------------------------------------------------------
# HTTP Server
# -----------------------------------------------------------------------------

# Port the health/metrics HTTP server listens on.
# Must be an integer between 1 and 65535.
# Default: 3000
HEALTH_PORT=3000

# Optional: comma-separated exact origins allowed to call the health server
# cross-origin (e.g. the dashboard dev server). Unset = no CORS.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Nano node RPC endpoint used by the nano_payment task (NanoPaymentTool).
# Default: http://127.0.0.1:7076
# Must use HTTPS when STELLAR_NETWORK=mainnet.
# NANO_RPC_URL=http://127.0.0.1:7076

# Enable the nano_payment task. When true, startup fails unless a signing seed
# is configured via NANO_SEED (64 hex chars) or NANO_SEED_ARN (AWS Secrets
# Manager). The seed is never accepted in a task payload.
# NANO_ENABLED=false
# NANO_SEED=
# NANO_SEED_ARN=

# Allow task payloads to bypass the recipient account precheck. Keep disabled
# unless an operator explicitly accepts the risk of sending without the check.
# Defaults to false.
# NANO_ALLOW_SKIP_PRECHECK=false

# Bearer token for the HTTP API (/status, /spending, /metrics, /approvals and
# /admin/*). Keep it different from WEBHOOK_SECRET: that one signs outgoing
# webhooks, and sharing it means leaking one compromises the other.
# Required on mainnet. On testnet/futurenet the read endpoints are open without it.
# Using WEBHOOK_SECRET in its place still works when this is unset, but is deprecated.
# ADMIN_API_TOKEN=change-me-to-a-long-random-string

# Kill switch: start with every value-moving task halted (read-only tasks and
# /health keep working). Toggle at runtime with POST /admin/pause and
# POST /admin/resume (Bearer ADMIN_API_TOKEN). The paused state is persisted
# to the shared storage backend.
# Default: false
# PAUSED=false

# How often (ms) each instance re-reads the paused state from the shared
# storage backend (#960), so a pause/resume issued on one instance reaches
# every other instance sharing that store within this bound. Only matters
# with multiple instances sharing one store (typically STORAGE_BACKEND=postgres).
# Default: 2000
# KILL_SWITCH_SYNC_INTERVAL_MS=2000

# -----------------------------------------------------------------------------
# Persistence
# -----------------------------------------------------------------------------

# Path to the SQLite database file holding nonces and spending history.
# Relative paths are resolved from the process working directory.
# Default: ./agent.db
DB_PATH=./agent.db

# Storage backend: "sqlite" (default, single instance, uses DB_PATH) or
# "postgres" (shared by every instance of a horizontally scaled deployment).
# Schema migrations in backend/db/migrations/ are applied at startup either way.
# Default: sqlite
# STORAGE_BACKEND=sqlite

# Postgres connection string. Required when STORAGE_BACKEND=postgres.
# DATABASE_URL=postgres://nodal:nodal@localhost:5432/nodal

# Data retention (#963): how long to keep rows in tables that otherwise grow
# without bound — agent_results, decided/expired pending_approvals and
# trigger_events dedupe rows. The hash-chained audit log is never pruned.
# RETENTION_DAYS_RESULTS=30
# RETENTION_DAYS_APPROVALS=30
# RETENTION_DAYS_TRIGGER_EVENTS=30

# How often the retention job sweeps the tables above, in milliseconds.
# Default: 86400000 (once a day).
# RETENTION_JOB_INTERVAL_MS=86400000

# -----------------------------------------------------------------------------
# Timeouts & Caching
# -----------------------------------------------------------------------------

# Per-call RPC timeout in milliseconds. Must be an integer of at least 100.
# Default: computed as RETRY_DELAY_MS * MAX_RETRIES * 2 (9000 ms at the defaults),
# so raising MAX_RETRIES without setting this widens the timeout to match.
# RPC_TIMEOUT_MS=9000

# How long a fetched account entry is cached, in milliseconds.
# 0 disables caching. Must be an integer of at least 0.
# Default: 30000 (30 seconds)
ACCOUNT_CACHE_TTL_MS=30000

# How long a fetched stellar.toml is cached, in milliseconds.
# 0 disables caching. Must be an integer of at least 0.
# Default: 300000 (5 minutes)
TOML_CACHE_TTL_MS=300000

# Contract event listener polling interval in milliseconds.
# Must be an integer of at least 100.
# Unset = uses listener default interval.
# CONTRACT_EVENT_POLL_MS=5000

# -----------------------------------------------------------------------------
# AI Layer: LLM Provider (Optional)
# -----------------------------------------------------------------------------
# Configure an LLM provider to enable the AI planner layer.
# When not set, the agent operates in deterministic JSON-task mode only.

# LLM provider to use: openai | anthropic | mock
# Use "mock" for testing without making real API calls.
# Default: (not set - AI layer disabled)
# LLM_PROVIDER=mock

# Model identifier for the selected provider.
# OpenAI examples: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic examples: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Default: provider-specific default
# LLM_MODEL=gpt-4o

# API key for the LLM provider (secret - never logged).
# For OpenAI: https://platform.openai.com/api-keys
# For Anthropic: https://console.anthropic.com/settings/keys
# Required when LLM_PROVIDER is set to openai or anthropic.
# LLM_API_KEY=sk-...

# Base URL for OpenAI-compatible APIs (useful for local models, proxies).
# Examples: http://localhost:11434/v1 (Ollama), https://api.openai.com/v1
# Default: provider's default API endpoint
# LLM_BASE_URL=

# Request timeout in milliseconds.
# Default: 60000 (1 minute)
# LLM_TIMEOUT_MS=60000

# Maximum tokens per response.
# Default: 4096
# LLM_MAX_TOKENS=4096

# Temperature for sampling (0-2). Higher = more creative.
# Default: 0.7
# LLM_TEMPERATURE=0.7

# Optional URL used by the natural-language planner.
# LLM_ENDPOINT=https://api.openai.com/v1/chat/completions

# Planner budget settings; all values must be positive integers.
# LLM_MAX_TOKENS_PER_REQUEST=8000
# LLM_MAX_TOKENS_PER_STEP=16000
# LLM_MAX_TOOL_CALL_ITERATIONS=25
# LLM_MAX_TOKENS_PER_DAY=1000000

# In-memory AI session limits (positive integers).
# SESSION_TTL_MS=1800000
# SESSION_MAX_MESSAGES=50
# SESSION_MAX_SESSIONS=500

# -----------------------------------------------------------------------------
# Alerting (Optional)
# -----------------------------------------------------------------------------
# Webhook URLs are validated as URLs and are only registered when configured.
# ALERT_WEBHOOK_URL=https://example.com/nodal-alerts
# ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Spending thresholds are comma-separated positive fractions of the spending
# limit. Default: 0.8,1
# ALERT_SPENDING_THRESHOLDS=0.8,1
# Consecutive task failures and rolling alert window. Defaults: 5 and 300000 ms.
# ALERT_FAILURE_THRESHOLD=5
# ALERT_FAILURE_WINDOW_MS=300000

# -----------------------------------------------------------------------------
# Webhooks (Optional)
# -----------------------------------------------------------------------------

# URL to receive HTTP POST notifications on task completions and errors.
# Optional — webhooks disabled when unset.
# WEBHOOK_URL=https://example.com/webhooks/nodal

# Secret used to sign outgoing webhook payloads via HMAC-SHA256 (X-Nodal-Signature).
# Keep this distinct from ADMIN_API_TOKEN.
# WEBHOOK_SECRET=change-me-to-a-long-random-string

# Sign the body only (no timestamp in header). Deprecated — removed next release.
# Default: false
# WEBHOOK_LEGACY_SIGNATURE=false

# ---------------------------------------

# -----------------------------------------------------------------------------
# Escrow release deploys (scripts/deploy_escrow.ts). Secret key that pays for
# and owns the deploy; falls back to AGENT_SECRET_KEY when unset.
# DEPLOYER_SECRET_KEY=

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol) Server
# -----------------------------------------------------------------------------

# MCP transport: "stdio" (default, for Claude Desktop and similar) or "http".
# Default: stdio
# MCP_TRANSPORT=stdio

# Port for the MCP HTTP server. Must be an integer between 1 and 65535.
# Default: 3001
# MCP_PORT=3001

# Host/IP the MCP HTTP server binds to.
# Default: 127.0.0.1 (loopback only — only reachable from this machine).
# Set to 0.0.0.0 only when the MCP server must be reachable across the network
# AND you have an external firewall or auth layer in place.
# MCP_HOST=127.0.0.1

# Bearer token required on every MCP HTTP route.
# When MCP_ALLOW_PAYMENTS=true the server refuses to start without this token —
# an unauthenticated HTTP MCP endpoint with payment tools enabled would allow
# anyone who can reach the port to move funds from the agent account.
# Keep this value long, random, and secret (e.g. `openssl rand -hex 32`).
# MCP_API_TOKEN=change-me-to-a-long-random-string

# Maximum JSON body size accepted by the MCP HTTP endpoint, in bytes.
# Requests that exceed this limit are rejected with 413. Default: 1048576 (1 MiB).
# MCP_MAX_BODY_BYTES=1048576

# Allow value-moving tools (payments, swaps, contract invocations) to be called
# via MCP. Set to true only when MCP_API_TOKEN is configured and the MCP port is
# not publicly exposed. Default: false.
# MCP_ALLOW_PAYMENTS=false

# Optional Soroban custom account enforcing the agent's on-chain spending policy.
# AGENT_POLICY_ACCOUNT=C...
